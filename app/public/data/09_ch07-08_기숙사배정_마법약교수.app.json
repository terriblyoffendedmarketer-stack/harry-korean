{
  "id": "09_ch07-08_기숙사배정_마법약교수",
  "segments": [
    {
      "start": 5.28,
      "end": 17.595,
      "text": "정 모 주세요",
      "confidence": 1.0
    },
    {
      "start": 17.595,
      "end": 24.852,
      "text": "8장 마법약 교수 저기 있잖아 봐봐 어디 저 키큰",
      "confidence": 1.0
    },
    {
      "start": 24.852,
      "end": 32.887,
      "text": "빨간머리 옆에 안경 쓰네 얼굴 봤어 흉터는 거림은 다음날",
      "confidence": 1.0
    },
    {
      "start": 32.887,
      "end": 41.043,
      "text": "해리가 기숙사 실을 선 순간부터 그를 따라다녔다 아이들은",
      "confidence": 1.0
    },
    {
      "start": 41.043,
      "end": 48.434,
      "text": "해리를 한번 보겠다며 까치발을 들고 교실 밖에 늘어서",
      "confidence": 1.0
    },
    {
      "start": 48.434,
      "end": 56.27,
      "text": "있거나 복도에서는 갔던 길을 되돌아와 해리를 지나치면서",
