    },
    {
      "start": 665.47,
      "end": 668.024,
      "text": "눈이 엄마를 닮았어.",
      "confidence": 1.0
    },
    {
      "start": 668.024,
      "end": 672.171,
      "text": "그 애가 첫 마법 지팡이를 사려고",
