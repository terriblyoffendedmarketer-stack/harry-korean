{
  "id": "06_ch05b_다이애건앨리2",
  "segments": [
    {
      "start": 13.387,
      "end": 17.8,
      "text": "주세요 해그리드가 사 준 아이스크림을 먹는",
      "confidence": 1.0
    },
    {
      "start": 17.8,
      "end": 21.399,
      "text": "동안 해리는 아무 말도 하지 않았다",
      "confidence": 1.0
    },
    {
      "start": 21.399,
      "end": 25.586,
      "text": "잘게 부순 견과류를 뿌린 초콜릿과",
      "confidence": 1.0
    },
    {
      "start": 25.586,
      "end": 29.333,
      "text": "산딸기 맛이 나는 아이스크림이다",
      "confidence": 1.0
    },
    {
      "start": 29.333,
      "end": 33.707,
      "text": "왜 그러냐 해그리드가 물었다.",
      "confidence": 1.0
    },
    {
      "start": 33.707,
      "end": 38.139,
      "text": "“10년에 거짓말을 했다",
      "confidence": 1.0
    },
    {
      "start": 38.139,
      "end": 45.331,
      "text": "그들은 가게 들러 양피지와 깃펜을 샀다 해리는 글씨를 쓰면",
      "confidence": 1.0
    },
    {
      "start": 45.331,
      "end": 52.088,
      "text": "색깔이 바뀌는 잉크를 발견하고 나서 기분이 조금 좋아졌다",
      "confidence": 1.0
    },
    {
      "start": 52.088,
      "end": 56.011,
      "text": "가게를 떠나면서 해리가 물었다",
      "confidence": 1.0
    },
    {
      "start": 56.011,
      "end": 63.221,
      "text": "헤그리드 퀴디치가 뭐예요 이런 해리는 그게",
      "confidence": 1.0
    },
    {
      "start": 63.221,
      "end": 70.13,
      "text": "뭔지 잊어 버리는구나 퀴디치 모른단 말이냐",
      "confidence": 1.0
    },
    {
      "start": 70.13,
      "end": 77.778,
      "text": "아저씨까지 그러지 않으셔도 저 기분 엉망이거나",
      "confidence": 1.0
    },
    {
      "start": 77.778,
      "end": 84.249,
      "text": "만난 허염 멀건 아이에 대해 이야기했다.",
      "confidence": 1.0
    },
    {
      "start": 84.249,
      "end": 89.674,
      "text": "“……그러더니 머글 집안 출신은 입학조차 시켜선",
      "confidence": 1.0
    },
    {
      "start": 89.674,
      "end": 94.697,
      "text": "안 된다는 거예요.”\n“너는 머글 집안 출신이",
      "confidence": 1.0
    },
    {
      "start": 94.697,
      "end": 100.413,
      "text": "아니야 그 녀석이 네 정체를 알기만 했어도 부모님이",
      "confidence": 1.0
    },
    {
      "start": 100.413,
      "end": 106.13,
      "text": "마법사라면 그 녀석도 어렸을 때부터 네 이름을 들으며",
      "confidence": 1.0
    },
    {
      "start": 106.13,
      "end": 110.819,
      "text": "자랐을 거다 너도 봤잖아, 리키 콜드런에서",
      "confidence": 1.0
    },
    {
      "start": 110.819,
      "end": 117.266,
      "text": "어땠는지 그건 그렇고 그 자식, 뭘 안다고 그런 소리를 해?",
      "confidence": 1.0
    },
    {
      "start": 117.266,
      "end": 123.397,
      "text": "내가 여태껏 본 최고의 마법사 중에는 조상 대대로 머 집안에서",
      "confidence": 1.0
    },
    {
      "start": 123.397,
      "end": 126.9,
      "text": "태어나 오직 혼자서만 마법을 할 수",
      "confidence": 1.0
    },
    {
      "start": 126.9,
      "end": 130.754,
      "text": "있었던 사람들도 꽤 있다고 엄마를 봐라!",
      "confidence": 1.0
    },
    {
      "start": 130.754,
      "end": 137.28,
      "text": "언니라고 하나 있는 게 어떤지를 보란 말이야!”\n“아무튼",
      "confidence": 1.0
    },
    {
      "start": 137.28,
      "end": 140.951,
      "text": "퀴디치 뭐예요?”\n“그건 우리가",
      "confidence": 1.0
    },
    {
      "start": 140.951,
      "end": 144.826,
      "text": "하는 스포츠야 마법사들의 스포츠지.",
      "confidence": 1.0
    },
    {
      "start": 144.826,
      "end": 148.776,
      "text": "그러니까 세계의 축구랑 비슷한 거야.",
      "confidence": 1.0
    },
    {
      "start": 148.776,
      "end": 151.108,
      "text": "모두가 퀴디치를 보거든.",
      "confidence": 1.0
    },
    {
      "start": 151.108,
      "end": 156.126,
      "text": "빗자루를 타고 하늘을 날면서 하는 경기인데,",
      "confidence": 1.0
    },
    {
      "start": 156.126,
      "end": 160.038,
      "text": "공이 네 개 있고 규칙을 설명하는",
      "confidence": 1.0
    },
    {
      "start": 160.038,
      "end": 164.155,
      "text": "게 좀 힘드네.”\n“그럼 슬리데린하고",
      "confidence": 1.0
    },
    {
      "start": 164.155,
      "end": 167.567,
      "text": "후플푸프는요?”\n“학교 기숙사",
      "confidence": 1.0
    },
    {
      "start": 167.567,
      "end": 171.381,
      "text": "이름이야 기숙사는 네 군데가 있어.",
      "confidence": 1.0
    },
    {
      "start": 171.381,
      "end": 177.568,
      "text": "다들 후플푸프는 얼간이들이 모여 있는 데라고 하지만…….”",
      "confidence": 1.0
    },
    {
      "start": 177.568,
      "end": 180.755,
      "text": "“그럼 전 틀림없이 후플푸프에",
      "confidence": 1.0
    },
    {
      "start": 180.755,
      "end": 184.692,
      "text": "들어가겠네요.” 해리가 우울하게 말했다",
      "confidence": 1.0
    },
    {
      "start": 184.692,
      "end": 188.655,
      "text": "슬리데린에 들어가느니 후플푸프가",
      "confidence": 1.0
    },
    {
      "start": 188.655,
      "end": 193.279,
      "text": "낫지 해그리드가 얼굴을 찌푸리며 말했다",
      "confidence": 1.0
    },
    {
      "start": 193.279,
      "end": 196.311,
      "text": "악당이 된 마법사 중에 슬리데린",
      "confidence": 1.0
    },
    {
      "start": 196.311,
      "end": 199.512,
      "text": "출신이 아닌 사람은 한 명도 없어.",
      "confidence": 1.0
    },
    {
      "start": 199.512,
      "end": 204.982,
      "text": "‘그 사람’도 슬리데린이었고.”\n“볼, 아니 죄송해요.",
      "confidence": 1.0
    },
    {
      "start": 204.982,
      "end": 212.786,
      "text": "‘그 사람’도 호그와트에 다녔어요?”\n“아주 오래전 일이지만",
      "confidence": 1.0
    },
    {
      "start": 212.786,
      "end": 215.541,
      "text": "해그리드가 게 말했다.",
      "confidence": 1.0
    },
    {
      "start": 215.541,
      "end": 221.609,
      "text": "“슬리 아는 서점에서 해리가 쓸 교과서를 샀다.",
      "confidence": 1.0
    },
    {
      "start": 221.609,
      "end": 225.394,
      "text": "그 가게의 책꽂이에는 도로 포장용",
      "confidence": 1.0
    },
    {
      "start": 225.394,
      "end": 230.176,
      "text": "돌만큼이나 크고 가죽 장정이 되어 있는 책,",
      "confidence": 1.0
    },
    {
      "start": 230.176,
      "end": 233.096,
      "text": "비단 표지의 우표만 한 책,",
      "confidence": 1.0
    },
    {
      "start": 233.096,
      "end": 236.159,
      "text": "기묘한 부호로 가득 찬 책,",
      "confidence": 1.0
    },
    {
      "start": 236.159,
      "end": 242.86,
      "text": "아무것도 적혀 있지 않은 책 등이 천장까지 빼곡히 꽂혀 있었다.",
      "confidence": 1.0
    },
    {
      "start": 242.86,
      "end": 246.2,
      "text": "뭔가를 읽는 일이 결코 없는",
      "confidence": 1.0
    },
    {
      "start": 246.2,
      "end": 250.792,
      "text": "더들리조차 여기 있는 책들은 갖고 싶어서",
      "confidence": 1.0
    },
    {
      "start": 250.792,
      "end": 255.765,
      "text": "난리를 칠 것 해그리드는 빈딕터스 비리디언",
      "confidence": 1.0
    },
    {
      "start": 255.765,
      "end": 261.775,
      "text": "교수가 쓴 저주와 저주 해제 친구들에게 마법을 걸고,",
      "confidence": 1.0
    },
    {
      "start": 261.775,
      "end": 266.453,
      "text": "최신 복수 마법으로 적들의 혼을 빼놓으세요",
      "confidence": 1.0
    },
    {
      "start": 266.453,
      "end": 269.851,
      "text": "탈모, 흐느적 다리, 혀 묶기,",
      "confidence": 1.0
    },
    {
      "start": 269.851,
      "end": 276.08,
      "text": "그 밖에도 아주아주 많은 저주 마법이 실려 있습니다”)라는",
      "confidence": 1.0
    },
    {
      "start": 276.08,
      "end": 280.799,
      "text": "책에 빠져 있는 해리를 거의 끌어내다시피 했다",
      "confidence": 1.0
    },
    {
      "start": 280.799,
      "end": 284.771,
      "text": "더들리한테 저주 걸 방법을 찾고 있었단",
      "confidence": 1.0
    },
    {
      "start": 284.771,
      "end": 289.827,
      "text": "말이에요.”\n“좋은 생각이 아니라고는 못 하겠지만,",
      "confidence": 1.0
    },
    {
      "start": 289.827,
      "end": 291.42,
      "text": "머글 세계에서는",
      "confidence": 1.0
    },
    {
      "start": 291.42,
      "end": 294.783,
      "text": "아주 특수한 상황이 아니면 마법을",
      "confidence": 1.0
    },
    {
      "start": 294.783,
      "end": 297.792,
      "text": "써선 안 돼 해그리드가 말했다.",
      "confidence": 1.0
    },
    {
      "start": 297.792,
      "end": 300.926,
      "text": "“게다가 어쨌든 넌 아직 저런",
      "confidence": 1.0
    },
    {
      "start": 300.926,
      "end": 304.613,
      "text": "저주 가운데 어떤 것도 쓸 수 없어.",
      "confidence": 1.0
    },
    {
      "start": 304.613,
      "end": 311.147,
      "text": "저 정도 수준이 되려면 공부를 아주 많이 해야 되거든",
      "confidence": 1.0
    },
    {
      "start": 311.147,
      "end": 314.855,
      "text": "해그리드는 황금 솥도 사지 못하게",
      "confidence": 1.0
    },
    {
      "start": 314.855,
      "end": 320.32,
      "text": "했다(“준비물 목록에 백랍이라고 적혀 이 아 하지만",
      "confidence": 1.0
    },
    {
      "start": 320.32,
      "end": 325.671,
      "text": "마법약에 들어가는 재료의 무게를 다는 저울과 접을",
      "confidence": 1.0
    },
    {
      "start": 325.671,
      "end": 330.639,
      "text": "수 있는 노스의 망원경은 좋은 것으로 장만했다.",
      "confidence": 1.0
    },
    {
      "start": 330.639,
      "end": 334.902,
      "text": "그런 다음 그들은 약재상에 들렀는데,",
      "confidence": 1.0
    },
    {
      "start": 334.902,
      "end": 340.586,
      "text": "그곳은 상한 달걀과 썩은 양배추를 섞어 놓은 듯한",
      "confidence": 1.0
    },
    {
      "start": 340.586,
      "end": 346.269,
      "text": "끔찍한 냄새를 보상하고도 남을 만큼 멋진 곳이었다.",
      "confidence": 1.0
    },
    {
      "start": 346.269,
      "end": 350.172,
      "text": "바닥에는 뭔가 끈적끈적한 게 잔뜩",
      "confidence": 1.0
    },
    {
      "start": 350.172,
      "end": 354.691,
      "text": "들어 있는 커다란 통이 여러 개 있었고,",
      "confidence": 1.0
    },
    {
      "start": 354.691,
      "end": 358.701,
      "text": "벽을 따라 약초와 말린 뿌리 밝은색",
      "confidence": 1.0
    },
    {
      "start": 358.701,
      "end": 363.313,
      "text": "가루가 들어 있는 단지가 줄지어 있었으며,",
      "confidence": 1.0
    },
    {
      "start": 363.313,
      "end": 367.673,
      "text": "천장에는 깃털 묶음이 송곳니와 이리저리",
      "confidence": 1.0
    },
    {
      "start": 367.673,
      "end": 372.628,
      "text": "얽힌 발톱들을 엮어 놓은 줄이 매달려 있었다.",
      "confidence": 1.0
    },
    {
      "start": 372.628,
      "end": 378.594,
      "text": "해그리드가 계산대에 있는 남자에게 해리가 쓸 기초",
      "confidence": 1.0
    },
    {
      "start": 378.594,
      "end": 385.199,
      "text": "마법약 재료를 부탁하는 동안 정작 해리 본인은 하나에 2",
      "confidence": 1.0
    },
    {
      "start": 385.199,
      "end": 391.485,
      "text": "갈레온이나 하는 은색 유니콘 뿔과 매우 작고 반짝이는",
      "confidence": 1.0
    },
    {
      "start": 391.485,
      "end": 398.609,
      "text": "딱정벌레 눈알(한 국자에 5크넛이었다)을 자세히 들여다보았다.",
      "confidence": 1.0
    },
    {
      "start": 398.609,
      "end": 405.133,
      "text": "해그리드는 약재상 나와서 해리의 준비물 목록을 다시 확인했다.",
      "confidence": 1.0
    },
    {
      "start": 405.133,
      "end": 408.948,
      "text": "“이제 마법 지팡이만 사면 되겠구나.",
      "confidence": 1.0
    },
    {
      "start": 408.948,
      "end": 418.281,
      "text": "아, 그래. 네 생일 선물도 아직 안 좋네 해리는 얼굴이 빨개지는 듯했다.",
      "confidence": 1.0
    },
    {
      "start": 418.281,
      "end": 425.365,
      "text": "“안 그러셔도 되는…….”\n“안 그래도 된다는 건 나도 알지.",
      "confidence": 1.0
    },
    {
      "start": 425.365,
      "end": 430.4,
      "text": "있잖냐, 해리 너에게 동물을 하나 사 줄 생각이다",
      "confidence": 1.0
    },
    {
      "start": 430.4,
      "end": 432.152,
      "text": "두꺼비는 별로야.",
      "confidence": 1.0
    },
    {
      "start": 432.152,
      "end": 435.178,
      "text": "몇 년 전에 유행이 지났거든.",
      "confidence": 1.0
    },
    {
      "start": 435.178,
      "end": 438.719,
      "text": "두꺼비를 데려가면 애들이 웃을 거야",
      "confidence": 1.0
    },
    {
      "start": 438.719,
      "end": 440.726,
      "text": "고양이는 내가 싫고.",
      "confidence": 1.0
    },
    {
      "start": 440.726,
      "end": 444.578,
      "text": "고양이 근처에 가면 재채기가 나오거든.",
      "confidence": 1.0
    },
    {
      "start": 444.578,
      "end": 447.281,
      "text": "올빼미를 한 마리 사 주마.",
      "confidence": 1.0
    },
    {
      "start": 447.281,
      "end": 452.172,
      "text": "애들은 다 올빼미나 부엉이를 갖고 싶어 하지.",
      "confidence": 1.0
    },
    {
      "start": 452.172,
      "end": 454.465,
      "text": "엄청나게 유용하거든.",
      "confidence": 1.0
    },
    {
      "start": 454.465,
      "end": 456.691,
      "text": "편지도 배달해 주고,",
      "confidence": 1.0
    },
    {
      "start": 456.691,
      "end": 459.737,
      "text": "다 해 줘 20분 뒤 그들은",
      "confidence": 1.0
    },
    {
      "start": 459.737,
      "end": 463.925,
      "text": "부스럭대는 소리와 보석처럼 빛나며 쉴 새",
      "confidence": 1.0
    },
    {
      "start": 463.925,
      "end": 467.635,
      "text": "없이 깜빡이는 눈으로 가득 차 있던",
      "confidence": 1.0
    },
    {
      "start": 467.635,
      "end": 471.345,
      "text": "어두운 아일롭 부엉이 상점을 나섰다.",
      "confidence": 1.0
    },
    {
      "start": 471.345,
      "end": 477.477,
      "text": "이제 해리의 손에는 커다란 새장이 하나 들려 있고 그 안에",
      "confidence": 1.0
    },
    {
      "start": 477.477,
      "end": 481.007,
      "text": "아름다운 흰올빼미가 날개죽지 아래",
      "confidence": 1.0
    },
    {
      "start": 481.007,
      "end": 484.538,
      "text": "머리를 파묻고 깊이 잠들어 있었다.",
      "confidence": 1.0
    },
    {
      "start": 484.538,
      "end": 489.28,
      "text": "해리는 고맙다는 인사를 멈출 수가 없었다.",
      "confidence": 1.0
    },
    {
      "start": 489.28,
      "end": 495.85,
      "text": "자꾸만 말을 더듬어서 퀴럴 교수 같은 말투가 되었다.",
